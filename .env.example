# =============================================================================
# ONEX Infrastructure -- Bootstrap Environment Configuration
# =============================================================================
# This file contains ONLY the values needed to bootstrap the infrastructure.
# After bootstrap, runtime configuration is managed by Infisical.
#
# Setup (recommended -- generates every value below with real random secrets):
#   ./scripts/generate-local-env.sh
#
# Setup (manual):
#   cp .env.example .env
#   # Replace every __REPLACE_*__ placeholder below. `onex up core` refuses to
#   # start while any required var is unset, but it cannot tell a placeholder
#   # from a real secret -- Infisical will fail at runtime on a malformed key.
#
# Everything required for `onex up core` is generated on YOUR machine. The
# Infisical instance in the core bundle is a container that runs on your host,
# so there is no account to create and no external vault to reach.
#
# The Infisical machine identity (INFISICAL_CLIENT_ID / _CLIENT_SECRET /
# _PROJECT_ID) is NOT needed for `onex up core`. It is minted against the
# running Infisical container by scripts/setup-infisical-identity.sh, and is
# only required for the `runtime` bundle -- see the optional section below.
#
# For the full pre-Infisical configuration, see docs/env-example-full.txt
#
# SECURITY:
#   - Generate passwords with: openssl rand -hex 32
#   - Never commit .env to version control
# =============================================================================

# --- Required: Database ---
POSTGRES_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# --- Optional: Database DSN (overrides default construction) ---
# OMNIBASE_INFRA_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5436/omnibase_infra

# --- Required: Valkey Cache ---
# Valkey starts with `--requirepass "$VALKEY_PASSWORD"`, so `onex up core` requires it.
# Generate with: openssl rand -hex 32
VALKEY_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# --- Required: Infisical (self-hosted container in the core bundle) ---
# Infisical refuses to start without these, and they have no inline defaults.
# Generate INFISICAL_ENCRYPTION_KEY with: openssl rand -hex 16   (must be 32 hex chars)
# Generate INFISICAL_AUTH_SECRET with:    openssl rand -base64 32
INFISICAL_ENCRYPTION_KEY=__REPLACE_WITH_OPENSSL_RAND_HEX_16__
INFISICAL_AUTH_SECRET=__REPLACE_WITH_OPENSSL_RAND_BASE64_32__

# Infisical reaches Valkey over the compose network -- this is the in-network
# service name and port, not the host-published one. Substitute the same value
# you set for VALKEY_PASSWORD above.
INFISICAL_REDIS_URL=redis://:__SAME_AS_VALKEY_PASSWORD__@valkey:6379

# --- Optional: Infisical machine identity (`runtime` bundle only) ---
# NOT required for `onex up core`. Mint these against the already-running
# Infisical container with scripts/setup-infisical-identity.sh, then set them
# here before bringing up the runtime bundle.
# INFISICAL_ADDR=http://localhost:8881
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=

# --- Optional: ONEX State ---
# Directory for hook and pipeline state management.
# Must exist on disk; used by omniclaude state manager and agent workflows.
# ONEX_STATE_DIR=

# --- Optional: Logging ---
# ONEX_LOG_LEVEL=INFO
# ONEX_ENVIRONMENT=development
