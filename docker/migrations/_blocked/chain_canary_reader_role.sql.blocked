-- ============================================================================
-- BLOCKED, NOT APPLIED. This file is NOT in any migration corpus (OMN-18060).
-- ============================================================================
-- It is parked here, with a `.blocked` suffix and outside `forward/` entirely,
-- because nothing scans this directory: the flat stream is
-- `forward/*.sql` (non-recursive) and the node stream is
-- `forward/nodes/<node>/*.sql` at exactly depth 2. Neither reaches here.
--
-- WHY IT COULD NOT LAND WITH THE REST OF OMN-18060
--
--   The grant it carries is on `omnibase_infra.public.delegation_workflow_state`,
--   so it can only be delivered by a FLAT forward migration: node-stream
--   migrations run against `NODE_POSTGRES_DB`, which every compose lane sets to
--   `omnidash_analytics` (docker-compose.infra.yml, docker-compose.judge.yml),
--   a database this table is not in.
--
--   The flat forward stream is currently FROZEN.
--   `tests/unit/db/test_migration_104_retired_omn17923.py`
--   ::test_surviving_stream_is_byte_identical_to_the_pre_3190_stream asserts the
--   stream fingerprints byte-identically to its pre-#3190 state over exactly 88
--   files. Measured 2026-09-09, with a positive control: adding this file as
--   ordinal 104 fails four assertions in that module (104 is a BURNED ordinal),
--   and adding a byte-identical copy as ordinal **105** still fails
--   `test_surviving_stream_is_byte_identical_to_the_pre_3190_stream`. So the
--   freeze is on ANY new flat migration, not on the burned ordinal. A restamp
--   does not lift it either: that assertion compares against hardcoded
--   pre-#3190 constants, and only editing them would satisfy it -- which would
--   destroy the retirement proof those constants exist to be.
--
--   That freeze is OMN-17923's to lift, and weakening another ticket's
--   retirement proof from inside this one is not a fix.
--
-- WHAT TO DO WHEN OMN-17923 LANDS
--
--   Move this file to `docker/migrations/forward/<NNN>_create_chain_canary_reader_role.sql`
--   and its sibling to `docker/migrations/rollback/rollback_<NNN>_...sql`, at a
--   NEW ordinal (104 stays burned), then
--   `python scripts/check_schema_fingerprint.py stamp`.
--
-- WHAT IS TRUE ON THE LANE UNTIL THEN, stated rather than implied
--
--   The role `chain_canary_reader` IS provisioned -- the credential seams in
--   this same change create it least-privilege and attach its LOGIN. It simply
--   holds no grant on the table, so the canary's link-2 readback connects,
--   passes the pg_roles identity probe, and fails the SELECT with a permission
--   error. That surfaces as verdict `projection_readback_failed`, naming the
--   permission denial: RED and diagnosable, never green. Which is the whole
--   posture of this ticket.
-- ============================================================================

-- SPDX-FileCopyrightText: 2025 OmniNode.ai Inc.
-- SPDX-License-Identifier: MIT
-- =============================================================================
-- MIGRATION 104: Grant the chain_canary_reader role (OMN-18060)
-- =============================================================================
-- Ticket: OMN-18060. Precedents this file is modelled on: 094
--         (app_dashboard), 103 (tenant_projection_writer).
-- Version: 1.0.0
--
-- =============================================================================
-- WHY THIS FILE EXISTS
-- =============================================================================
-- `node_chain_canary_effect` proves 3 of the 5 OMN-16025 chain links and fails
-- closed on link 2 -- "routing decision PUBLISHED and PROJECTED, readback from
-- projection, not logs". Run 34281968883 reported
-- `projection_readback_not_configured -- no DSN was configured for the
-- projection readback`. The refusal is correct; the gate was unclosable,
-- because there was no reader identity for the canary to close it with.
--
-- Live readback of the .201 dev lane (compose project `omnibase-infra`,
-- container `omnibase-infra-postgres`, database `omnibase_infra`), 2026-09-08,
-- `SELECT grantee, privilege_type FROM information_schema.role_table_grants
-- WHERE table_name = 'delegation_workflow_state'`:
--
--     jake_ro       | SELECT
--     lakshman_ro   | SELECT
--     postgres      | SELECT INSERT UPDATE DELETE TRUNCATE REFERENCES TRIGGER
--
-- Two least-privilege readers already hold SELECT on the exact relation --
-- and both are named for collaborators. A scheduled probe authenticating as a
-- person's read-only account attributes every one of its connections to that
-- person and couples the canary's fate to an account provisioned for an
-- unrelated purpose. `app_dashboard` was the other candidate and holds no
-- grant on this table at all.
--
-- Hence a role of its own, provisioned the way every other login role on this
-- corpus is (see "HOW THE CREDENTIAL IS MINTED" below), and scoped to exactly
-- the one query the canary runs.
--
-- =============================================================================
-- WHAT IT MAY READ, AND WHY THE GRANT IS COLUMN-SCOPED
-- =============================================================================
-- The canary issues exactly two statements:
--
--     SELECT rolname, rolsuper, rolbypassrls FROM pg_roles
--      WHERE rolname = current_user;                       -- the identity probe
--     SELECT state FROM delegation_workflow_state
--      WHERE correlation_id = $1;                          -- the link-2 read
--
-- `pg_roles` is readable by PUBLIC and needs no grant. The link-2 read touches
-- two columns, so the grant names two columns. `delegation_workflow_state`
-- also carries `payload jsonb` -- the delegation's own request and response
-- material -- and `tenant_id`. A relation-wide `GRANT SELECT` would hand a
-- scheduled CI probe every tenant's payloads to close a liveness gate that
-- needs one enum-ish string. Column-level SELECT is the ordinary Postgres
-- mechanism for that and costs nothing here.
--
-- NO write privilege of any kind, and no `GRANT ... ON ALL TABLES`: this role
-- is an instrument, and an instrument that can write is not a read.
--
-- =============================================================================
-- WHY NOSUPERUSER / NOBYPASSRLS ARE PINNED AND ASSERTED
-- =============================================================================
-- The node probes `pg_roles` for `rolsuper` / `rolbypassrls` on connect and
-- REFUSES the readback (status `refused`, verdict
-- `projection_readback_refused`) when either is set. That check exists because
-- a privileged read succeeds and its green means less than it looks: a role
-- with either attribute is exempt from row-level security unconditionally, so
-- it cannot tell "the projection is readable" from "the projection is readable
-- by an identity nothing else has". Both ends of that contract are asserted --
-- there, at connect time on the live DSN, and here, on the role.
--
-- HONEST SCOPE NOTE (CLAUDE.md rule 24(d)): `delegation_workflow_state` on the
-- compose dev lane has `relrowsecurity = false` (live readback, same session).
-- No RLS policy is enforced against this role on that lane, so this migration
-- does NOT prove the reader is correctly constrained under RLS -- only that it
-- cannot bypass RLS wherever RLS exists. That is a real gap and it is stated
-- rather than papered over.
--
-- =============================================================================
-- HOW THE CREDENTIAL IS MINTED -- NEVER IN THIS FILE
-- =============================================================================
-- 094's invariant, restated by 099 and 103: no credential material ever lives
-- in a migration. This file issues GRANTs and asserts attributes; it never
-- creates a LOGIN and never carries a password.
--
-- The role is created and its password attached by the two deployment-owned
-- seams that already do this for `omninode_runtime` and
-- `tenant_projection_writer`, both of which this change adds
-- `chain_canary_reader:CHAIN_CANARY_READER_PASSWORD` to:
--
--   * `docker/migrations/forward/000_create_multiple_databases.sh`
--     (`LOGIN_ONLY_ROLE_MAP`, Phase 2b) -- fresh volumes.
--   * `scripts/run-forward-migrations.sh`
--     (`reassert_login_only_role_credential`) -- warm volumes, every compose
--     up. OMN-16993 added that seam precisely because a role created NOLOGIN
--     by a migration stays NOLOGIN forever on a warm volume.
--
-- Both skip cleanly when the password variable is unset, which is the correct
-- posture for a lane that has not provisioned the canary: the role is absent,
-- this file's grants are skipped with a NOTICE, and the canary reports
-- `skipped_not_configured` -- red, and honest, rather than a green from a
-- check that never ran.
--
-- =============================================================================
-- LANE SCOPE
-- =============================================================================
-- Dev lane only in practice. Nothing here is lane-conditional (a migration
-- cannot be, and pretending otherwise would be worse), but the DSN reference
-- that makes the role reachable is declared for the `dev` lane ONLY in
-- omnimarket `config/ci_bus_lanes.yaml`, and
-- `lane_transport.load_lane_projection_readback` REFUSES a declaration on any
-- other lane. On a lane with no `CHAIN_CANARY_READER_PASSWORD` this file is an
-- idempotent no-op.
-- =============================================================================

-- -----------------------------------------------------------------------------
-- 1. Attribute assertion. The role is CREATED by the credential seam above, not
--    here. If it is absent this whole file is a no-op -- an unprovisioned lane
--    is a legitimate state, unlike 103's principal, which the runtime hard-
--    requires.
-- -----------------------------------------------------------------------------
DO $$
DECLARE
  executing_role text := current_user;
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'chain_canary_reader'
  ) THEN
    RAISE NOTICE
      'chain_canary_reader is not provisioned on this lane (executing role %); '
      'skipping its grants. The chain canary will report '
      'skipped_not_configured for OMN-16025 link 2, which is RED and correct. '
      'To provision: set CHAIN_CANARY_READER_PASSWORD (openssl rand -hex 32) '
      'in the lane environment and re-run the forward migrations.',
      executing_role;
    RETURN;
  END IF;

  -- An escalation on this role is fatal to the meaning of the canary's green,
  -- so it is corrected where possible and raised where not. Gated on an
  -- OBSERVED divergence: re-asserting an already-correct value is not
  -- idempotence, it is a privilege demand made on every apply (103's 1.0.0
  -- defect).
  IF EXISTS (
    SELECT 1
      FROM pg_catalog.pg_roles
     WHERE rolname = 'chain_canary_reader'
       AND (rolsuper OR rolbypassrls OR rolreplication OR rolcreatedb OR rolcreaterole)
  ) THEN
    BEGIN
      ALTER ROLE chain_canary_reader
        NOSUPERUSER NOBYPASSRLS NOREPLICATION NOCREATEDB NOCREATEROLE;
      RAISE NOTICE 'corrected chain_canary_reader attributes as %', executing_role;
    EXCEPTION
      WHEN insufficient_privilege THEN
        RAISE EXCEPTION USING
          ERRCODE = 'insufficient_privilege',
          MESSAGE =
            'chain_canary_reader carries at least one of SUPERUSER, BYPASSRLS, '
            'REPLICATION, CREATEDB or CREATEROLE, and the executing role cannot '
            'remove them.',
          DETAIL =
            'SUPERUSER and BYPASSRLS exempt this role from row-level security '
            'unconditionally. node_chain_canary_effect probes pg_roles on '
            'connect and refuses the readback when it sees either, so leaving '
            'them set does not produce a false green -- it produces a '
            'permanently refused link 2.',
          HINT =
            'A role administrator must correct the role before the chain '
            'canary can prove OMN-16025 link 2. Ticket: OMN-18060.';
    END;
  END IF;
END
$$;

-- -----------------------------------------------------------------------------
-- 2. The grants. Guarded on the role's existence for the same reason as above,
--    and read back in step 3 rather than assumed: a GRANT issued by a role
--    without grant option on the object emits `WARNING: no privileges were
--    granted` and RETURNS SUCCESS (103's D2 finding).
-- -----------------------------------------------------------------------------
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'chain_canary_reader'
  ) THEN
    RETURN;
  END IF;

  EXECUTE format(
    'GRANT CONNECT ON DATABASE %I TO chain_canary_reader', current_database()
  );
  EXECUTE 'GRANT USAGE ON SCHEMA public TO chain_canary_reader';
  -- Column-scoped on purpose. `payload` and `tenant_id` are deliberately NOT
  -- in this list; see the header.
  EXECUTE
    'GRANT SELECT (correlation_id, state) '
    'ON public.delegation_workflow_state TO chain_canary_reader';
END
$$;

-- -----------------------------------------------------------------------------
-- 3. Read the outcome back. A silent no-op GRANT is the failure mode this step
--    exists for; a probe that cannot read link 2 is a canary that reports RED
--    forever with no explanation on the database side.
-- -----------------------------------------------------------------------------
DO $$
DECLARE
  granted_columns text[];
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'chain_canary_reader'
  ) THEN
    RETURN;
  END IF;

  SELECT array_agg(column_name ORDER BY column_name)
    INTO granted_columns
    FROM information_schema.column_privileges
   WHERE grantee = 'chain_canary_reader'
     AND table_schema = 'public'
     AND table_name = 'delegation_workflow_state'
     AND privilege_type = 'SELECT';

  IF granted_columns IS NULL
     OR NOT (granted_columns @> ARRAY['correlation_id', 'state']) THEN
    RAISE EXCEPTION USING
      ERRCODE = 'insufficient_privilege',
      MESSAGE = format(
        'chain_canary_reader holds SELECT on %s of '
        'public.delegation_workflow_state after this migration ran; '
        'correlation_id and state are both required.',
        coalesce(granted_columns::text, 'no columns')),
      DETAIL =
        'PostgreSQL does not raise for a GRANT issued without grant option on '
        'the object -- it emits a WARNING and returns success. This assertion '
        'is the only thing that distinguishes a real grant from that no-op.',
      HINT =
        'Re-run this migration as a role that owns '
        'public.delegation_workflow_state or holds grant option on it. '
        'Ticket: OMN-18060.';
  END IF;

  IF NOT has_database_privilege('chain_canary_reader', current_database(), 'CONNECT') THEN
    RAISE EXCEPTION USING
      ERRCODE = 'insufficient_privilege',
      MESSAGE = format(
        'chain_canary_reader cannot CONNECT to %I after this migration ran.',
        current_database()),
      HINT = 'Ticket: OMN-18060.';
  END IF;

  RAISE NOTICE
    'chain_canary_reader: CONNECT on % and SELECT(correlation_id, state) on '
    'public.delegation_workflow_state confirmed by readback',
    current_database();
END
$$;
