#
# The Dev settings set for apply_cloud_database.sql (OMN-26712). Names only, never a
# credential: the cloud owner creates these roles and stores their secrets, and overrides any
# value below in the migration job's environment when Dev names differ.
ONEX_CLOUD_DATABASE=onex_dev_cloud
ONEX_CLOUD_GATEWAY_ROLE=onex_dev_gateway
ONEX_CLOUD_TENANT_IDENTITY_WRITER_ROLE=onex_dev_tenant_writer
