[Unit]
Description=OmniNode CI runner pool on h053, the HP ProLiant Gen9 (OMN-22111, resized by OMN-19998)
Before=slices.target

# Five runners at 6 GiB with the job directories on the NVMe (OMN-26093; they were 9 GiB tmpfs-backed under OMN-19998), and
# the four merge-queue runners at 4 GiB, share this slice: 46 GiB of limits. MemorySwapMax is 0 and each runner's memswap
# equals its memory, so nothing in the pool reaches the rotational root volume through swap.
# Read 2026-11-04 on h053: 125 GiB, 49 to 55 GiB available with the lab-work units running, so the 46G ceiling leaves
# 3 to 15 GiB to the lanes however the runners behave.
[Slice]
MemoryAccounting=yes
MemoryHigh=45G
MemoryMax=46G
MemorySwapMax=0
CPUAccounting=yes
CPUWeight=25
