# OMN-18693 dogfood-lane inputs (compose project omnibase-infra-dogfood).
#
# Policy values come from docker/runtime-policy.env, which is rendered from
# contracts/services/runtime_policy.contract.yaml. This file is only for the
# credentials and local paths the lane owner must supply without editing source.
#
# The operator environment supplies the required credential references. Values
# remain empty here so this tracked example cannot accidentally satisfy a
# compose interpolation guard.

# Required for dogfood deploy-runtime.sh invocations. Set an absolute private
# root so staged deployments, locks, registries, and tags do not share dev
# state. This is read by deploy-runtime.sh from the operator environment.
OMNIBASE_INFRA_DEPLOY_ROOT=

POSTGRES_PASSWORD=
VALKEY_PASSWORD=
OMNINODE_RUNTIME_PASSWORD=
TENANT_PROJECTION_WRITER_PASSWORD=

# Required: an absolute host skills directory mounted read-only at /app/skills.
# Set this in the operator environment; relative paths are invalid after the
# deployment package is staged under the isolated deployment root.
OMNICLAUDE_SKILLS_DIR=

# OPTIONAL model credentials. Unlike the judge lane, this lane boots to a
# healthy /health with every one of these empty; wire a backend when you get to
# the `onex delegate` round-trip, not before.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_GLM_API_KEY=

# Optional GitHub/Linear effects. Leave empty — a dogfood lane has no
# business creating tickets or PRs.
GITHUB_TOKEN=
LINEAR_API_KEY=

# Optional local endpoint hardening knobs.
LOCAL_LLM_SHARED_SECRET=
LLM_ENDPOINT_CIDR_ALLOWLIST=

# Optional lane sizing. The broker defaults to 2G (see correction (c) in
# docker/docker-compose.dogfood.yml); raise it only if you actually need to.
DOGFOOD_REDPANDA_MEMORY=2G
DOGFOOD_REDPANDA_ADVERTISED_HOST=
