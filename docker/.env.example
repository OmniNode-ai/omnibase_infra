# =============================================================================
# ONEX Infrastructure Runtime -- Bootstrap Docker Environment
# =============================================================================
# SECURITY WARNING: This is an example file. Do NOT commit real credentials.
#
# REQUIRED: Copy this file to .env and set POSTGRES_PASSWORD before use.
# After bootstrap, runtime config is managed by Infisical.
#
# Usage:
#   cp docker/.env.example docker/.env
#   # Set POSTGRES_PASSWORD
#   docker compose -f docker/docker-compose.infra.yml up -d
#
# For the full pre-Infisical configuration, see docker/env-example-full.txt
# =============================================================================

# PASSWORD FORMAT CONTRACT (OMN-19087). Checked before any container starts
# by scripts/preflight_password_contract.py, which names every variable that
# breaks it. A set value outside its format is refused; the placeholder
# form __REPLACE_WITH_...__ is refused for all five.
#   POSTGRES_PASSWORD is url-safe (ASCII letters, digits, '.', '_' and '-' only, [A-Za-z0-9._-])
#   VALKEY_PASSWORD is url-safe (ASCII letters, digits, '.', '_' and '-' only, [A-Za-z0-9._-])
#   OMNINODE_RUNTIME_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
#   TENANT_PROJECTION_WRITER_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
#   CHAIN_CANARY_READER_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
# `openssl rand -hex 32` satisfies every format above.
# POSTGRES_PASSWORD is fixed once the Postgres data volume initialises: a
# changed value fails authentication against the existing volume. Set it
# once, before the first bring-up, and change only a variable a refusal
# names.
# --- REQUIRED: Set before first use ---
# SECURITY WARNING: Use a strong, unique password in production.
POSTGRES_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# --- Optional: Infisical (set after running scripts/setup-infisical-identity.sh) ---
# INFISICAL_ADDR=http://infisical:8080
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=

# --- Required: Infisical Encryption (secrets profile) ---
# Generate with: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=<REPLACE_BEFORE_USE_openssl_rand_hex_16>
# Generate with: openssl rand -hex 32
INFISICAL_AUTH_SECRET=<REPLACE_BEFORE_USE_openssl_rand_hex_32>

# --- Optional: Overrides ---
# POSTGRES_USER=postgres
# KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# VALKEY_PASSWORD=valkey-dev-password
# ONEX_LOG_LEVEL=INFO
# ONEX_ENVIRONMENT=development
# INTELLIGENCE_API_EXTERNAL_PORT=8053
