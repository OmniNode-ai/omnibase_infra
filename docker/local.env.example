# Laptop profile env TEMPLATE (OMN-19496) for the `local` catalog bundle.
#
# `make local-env` writes this file to ~/.omnibase/local.env with fresh
# passwords, and `make up-local` renders from that file ONLY: no other env file
# is read, so nothing from another setup leaks in. Values already exported in
# your shell still win, as with every compose interpolation.
#
# Nothing here is a lab or ops secret. The four passwords protect databases that
# exist only on your laptop.

# PASSWORD FORMAT: url-safe or hex; `openssl rand -hex 32` satisfies both.
# POSTGRES_PASSWORD is fixed once the Postgres volume initialises. Changing it
# later needs `make down-local-volumes` first (which deletes the local data).
POSTGRES_PASSWORD=__REPLACE_WITH_HEX__
VALKEY_PASSWORD=__REPLACE_WITH_HEX__

# The two non-superuser principals the lab lanes' runtimes and projection
# writers connect as (OMN-15425, OMN-18109). forward-migration asserts their
# LOGIN credential on every boot, so these may change without a volume reset.
# HEX ONLY: forward-migration refuses any other character.
OMNINODE_RUNTIME_PASSWORD=__REPLACE_WITH_HEX__
TENANT_PROJECTION_WRITER_PASSWORD=__REPLACE_WITH_HEX__

# The tenant your local runtime serves, left empty on purpose. Empty means your
# delegations use the model your overlay names. A tenant makes every delegation
# run on a provider key registered for that tenant and refuses everything else,
# so set one only to use your own key: `make tenant-local` writes it,
# `make up-local` applies it, `make secret-local PROVIDER=gemini` registers the key.
ONEX_TENANT_ID=

# The model your runtime delegates to: the ABSOLUTE path of your copy of
# docker/lane-overlays/local.bifrost.example.yaml. Edit the endpoint in that
# file, not here.
ONEX_LOCAL_BIFROST_OVERLAY=__REPLACE_WITH_ABSOLUTE_PATH__

# The broker address the runtime advertises to clients outside Docker. On a
# laptop the clients are on the same machine.
REDPANDA_ADVERTISE_HOST=localhost
# The broker's memory. Keep it well under your Docker Desktop VM's memory.
REDPANDA_MEMORY=2G
