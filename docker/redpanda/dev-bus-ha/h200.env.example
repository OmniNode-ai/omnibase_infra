# OMN-21430 dev bus member h200. Copy to h200.env on the host; holds no secret; replace each <hN-address> with the tailnet address from the lab host table.
# Docker Desktop's VM is 16 GiB (docker info, 2026-10-26) and another dev lane runs in it:
# raise it to at least 32 GiB before this member starts.
DEV_BUS_HA_ADVERTISE_HOST=<h200-address>
DEV_BUS_HA_SEEDS=<h201-address>:33145
DEV_BUS_HA_MEMORY=12G
DEV_BUS_HA_MEM_LIMIT=14g
