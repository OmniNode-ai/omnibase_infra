# OMN-21430 dev bus member h201. Copy to h201.env on the host; holds no secret; replace each <hN-address> with the tailnet address from the lab host table.
DEV_BUS_HA_ADVERTISE_HOST=<h201-address>
DEV_BUS_HA_SEEDS=<h201-address>:33145
# The existing dev broker's volume: this member keeps the cluster's data and node id.
DEV_BUS_HA_DATA_VOLUME=omnibase-infra-redpanda-data
DEV_BUS_HA_MEMORY=12G
DEV_BUS_HA_MEM_LIMIT=14g
