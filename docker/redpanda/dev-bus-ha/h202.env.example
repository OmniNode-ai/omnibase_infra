# OMN-21430 dev bus member h202. Copy to h202.env on the host; holds no secret.
# h202 is down for repair: replace <h202-address> with its tailnet address from the lab host table when it is back.
DEV_BUS_HA_ADVERTISE_HOST=<h202-address>
DEV_BUS_HA_SEEDS=<h201-address>:33145
DEV_BUS_HA_MEMORY=12G
DEV_BUS_HA_MEM_LIMIT=14g
