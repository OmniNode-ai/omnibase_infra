    {
      "clientId": "omnidash",
      "publicClient": false,
      "fullScopeAllowed": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "https://dash.omninode.ai/*##https://dev.dash.omninode.ai/*##http://localhost:3000/*##http://localhost:8080/*"
      },
