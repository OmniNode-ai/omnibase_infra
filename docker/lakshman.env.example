# OMN-17150 collaborator-lane inputs (compose project omnibase-infra-lakshman).
#
# Policy values come from docker/runtime-policy.env, which is rendered from
# contracts/services/runtime_policy.contract.yaml. This file is only for the
# credentials and local paths the lane owner must supply without editing source.
#
# Copy it, do not edit it in place:
#   cp docker/lakshman.env.example ~/.config/onex/lakshman.env
#   chmod 600 ~/.config/onex/lakshman.env
#
# Generate the four infrastructure passwords FRESH for this lane with
# `openssl rand -hex 32` (base64 output breaks the contract below). Never
# reuse another lane's values, and never paste a real value into a ticket, a
# PR, or chat — only the variable NAME belongs there.
#
# They ship EMPTY deliberately (OMN-17150 review finding). The compose file's
# `:?` guards reject an empty value, so an un-edited copy of this template makes
# the lane REFUSE TO START instead of booting. A non-empty placeholder here
# would satisfy those guards and quietly bring the lane up on a credential that
# is public in git history — fail-open, while this comment claimed fail-closed.

# PASSWORD FORMAT CONTRACT (OMN-19087). Checked before any container starts
# by scripts/preflight_password_contract.py, which names every variable that
# breaks it. A set value outside its format is refused; the placeholder
# form __REPLACE_WITH_...__ is refused for all five.
#   POSTGRES_PASSWORD is url-safe (ASCII letters, digits, '.', '_' and '-' only, [A-Za-z0-9._-])
#   VALKEY_PASSWORD is url-safe (ASCII letters, digits, '.', '_' and '-' only, [A-Za-z0-9._-])
#   OMNINODE_RUNTIME_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
#   TENANT_PROJECTION_WRITER_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
#   CHAIN_CANARY_READER_PASSWORD is hex (hexadecimal digits only, [0-9a-fA-F])
# `openssl rand -hex 32` satisfies every format above.
# POSTGRES_PASSWORD is fixed once the Postgres data volume initialises: a
# changed value fails authentication against the existing volume. Set it
# once, before the first bring-up, and change only a variable a refusal
# names.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
OMNINODE_RUNTIME_PASSWORD=
TENANT_PROJECTION_WRITER_PASSWORD=

# Required: the host skills tree mounted read-only at /app/skills, pointing at
# the SIBLING omnimarket checkout ($OMNI_HOME/omnimarket/plugins/onex/skills).
#
# Compose resolves a relative bind-mount source against the directory of the
# first `-f` compose file — that is `docker/`, NOT the repo root. So reaching a
# sibling checkout needs TWO levels up. `../omnimarket/...` resolved to
# `<repo>/omnimarket/...`, which does not exist (OMN-17150 review finding).
# This matters more than a missing mount: a runtime with no skills tree reports
# healthy and then cannot serve a single skill.
OMNICLAUDE_SKILLS_DIR=../../omnimarket/plugins/onex/skills

# OPTIONAL model credentials. Unlike the judge lane, this lane boots to a
# healthy /health with every one of these empty; wire a backend when you get to
# the `onex delegate` round-trip, not before.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_GLM_API_KEY=

# Optional GitHub/Linear effects. Leave empty — a collaborator lane has no
# business creating tickets or PRs.
GITHUB_TOKEN=
LINEAR_API_KEY=

# Optional local endpoint hardening knobs.
LOCAL_LLM_SHARED_SECRET=
LLM_ENDPOINT_CIDR_ALLOWLIST=

# Optional lane sizing. The broker defaults to 2G (see correction (c) in
# docker/docker-compose.lakshman.yml); raise it only if you actually need to.
LAKSHMAN_REDPANDA_MEMORY=2G
