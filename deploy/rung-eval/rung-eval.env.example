#
# Host-local configuration for onex-rung-eval.service (OMN-19456).
#
#   install -m 600 deploy/rung-eval/rung-eval.env.example ~/.config/onex/rung-eval.env
#
# This template carries NAMES only, every line commented. The copy on a host is
# never committed: the values are lab addresses and a key. A line left commented
# leaves the variable unset, and the rung that needs it records a row with status
# `unresolved` naming the variable, which is the honest night for a host that
# cannot reach that rung. Do not leave a variable set and empty: an empty value
# is read as an address and records `error`.
#
# One block per rung in omnimarket's delegation_rung_eval.v1.yaml. The BASE_URL is
# the OpenAI-compatible root the runner appends /chat/completions to.

# lab-201
# RUNG_EVAL_LAB_201_BASE_URL=
# RUNG_EVAL_LAB_201_MODEL=

# lab-202
# RUNG_EVAL_LAB_202_BASE_URL=
# RUNG_EVAL_LAB_202_MODEL=

# planner-200
# RUNG_EVAL_PLANNER_200_BASE_URL=
# RUNG_EVAL_PLANNER_200_MODEL=

# cloud-openrouter (the only rung with a key)
# RUNG_EVAL_CLOUD_OPENROUTER_BASE_URL=
# RUNG_EVAL_CLOUD_OPENROUTER_MODEL=
# RUNG_EVAL_CLOUD_OPENROUTER_API_KEY=

# Where this host keeps the omnimarket clone the runner is read from, where the
# table lives, and how many nights back the missing-night check looks at most.
# Unit defaults: ~/Code/omni_home/omnimarket, ~/.local/share/onex/rung-eval, 14.
# RUNG_EVAL_OMNIMARKET_DIR=
# RUNG_EVAL_TABLE_DIR=
# RUNG_EVAL_WINDOW_DAYS=14
