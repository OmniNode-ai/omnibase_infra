#
# OMN-20805: this schedule ran from /etc/cron.d, which records a start and no end.
# As a oneshot service under a timer, the journal records every run's start, end and
# exit status. Installed and enabled by deploy/maintenance/omninode-host-maintenance-sync.sh.

[Unit]
Description=Converge the deploy runner's private OMNI_HOME clone tree (OMN-18567)
Documentation=https://github.com/OmniNode-ai/omnibase_infra

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/data/maintenance/bin/omninode-runner-tree-converge.sh --converge
StandardOutput=append:/data/maintenance/logs/runner-tree-converge.log
StandardError=append:/data/maintenance/logs/runner-tree-converge.log
SyslogIdentifier=omninode-runner-tree-converge
