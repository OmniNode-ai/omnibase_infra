#
# OMN-20805: this schedule ran from /etc/cron.d, which records a start and no end.
# As a oneshot service under a timer, the journal records every run's start, end and
# exit status. Installed and enabled by deploy/maintenance/omninode-host-maintenance-sync.sh.

[Unit]
Description=Reconcile the deploy-source clones and host venvs (OMN-17311)
Documentation=https://github.com/OmniNode-ai/omnibase_infra

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# cron gave root jobs HOME=/root; a system service has no HOME unless it sets one, and
# the maintenance scripts run under `set -u` (the first timer run of the alert report
# died with 'HOME: unbound variable' on the lab host before this line).
Environment=HOME=/root
Environment=LOGNAME=root
# OMN-24899: this unit runs as root and runs the dispatch venv's python for its readbacks; the
# bytecode root writes into the owner's venv is root-owned and the owner's installer cannot delete
# it, which left a `.atomic-stage.*` folder in the venv root after an omnimarket move.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/data/maintenance/bin/omninode-workspace-reconcile.sh
StandardOutput=append:/data/maintenance/logs/workspace-reconcile.log
StandardError=append:/data/maintenance/logs/workspace-reconcile.log
SyslogIdentifier=omninode-workspace-reconcile
