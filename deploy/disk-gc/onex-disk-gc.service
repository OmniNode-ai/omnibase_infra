#
# onex-disk-gc.service — .201 disk maintenance pass (OMN-13008).
#
# A systemd USER unit (NOT a lane container). One-shot maintenance run, triggered
# by onex-disk-gc.timer. Runs three conservative passes in order:
#   1. disk-gc.sh       — conservative docker/builder/image GC honoring keep-list
#   2. docker-volume-gc.sh — unused anonymous + ephemeral boot volumes only
#   3. disk-watermark-check.sh — emit bus alert if /data crosses the watermark
#
# Worktree GC is NO LONGER one of them: it moved to onex-worktree-prune.service
# under OMN-18688, because it needed a ledger-CLAIM-aware predicate this unit's
# hourly cadence and fire-and-forget shape were the wrong home for.
#
# Install (on .201, as the runtime user — NO sudo, user scope):
#   bash deploy/disk-gc/install-disk-gc.sh
#
# Check:
#   systemctl --user status onex-disk-gc.timer
#   journalctl --user -u onex-disk-gc.service -f

[Unit]
Description=ONEX .201 disk maintenance (worktree GC + docker GC + watermark alert)
Documentation=https://github.com/OmniNode-ai/omnibase_infra
After=docker.service

[Service]
Type=oneshot

# Resolve OMNI_HOME for the runtime user on .201.
Environment="OMNI_HOME=%h/Code/omni_home"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# KAFKA_BOOTSTRAP_SERVERS for the watermark bus publish is sourced from the
# operator env file (not hardcoded in source). Optional ('-' prefix): if the
# file is absent the watermark check still runs but logs the event instead of
# publishing (fail-soft on the alert publish, never a silent default broker).
EnvironmentFile=-%h/.omnibase/.env

ExecStartPre=/bin/mkdir -p %h/.local/log/onex

# 1. RETIRED, OMN-18688 — worktree GC moved to onex-worktree-prune.service.
#
# This line used to run worktree-gc.sh, which drives omniclaude's
# prune-worktrees.sh: that predicate removes a clean, pushed, merged worktree
# with `git worktree remove --force` and reads docs/tracking/ROLLING_WORK_LEDGER.md
# nowhere. Clean-and-pushed-and-merged is exactly the state a LIVE lane occupies
# between its push and its post-merge verification, which is the hazard OMN-15551
# measured. The replacement additionally requires no open ledger CLAIM row and
# drops --force so git re-checks cleanliness itself.
#
# It also passed --worktrees-root /data/omninode/omni_worktrees, which is missing
# the omni_home path segment: that directory holds one stale entry while the real
# root holds 163. This pass has therefore never removed a single real worktree on
# this host, which is why retiring it reclaims nothing and regresses nothing.
#
# Deliberately deleted rather than commented out as a runnable line: a commented
# ExecStart is one someone uncomments without reading why it was turned off.
# Disposition and evidence: deploy/disk-gc/README-worktree-prune.md

# 2. Conservative docker/disk GC honoring the versioned keep-list.
ExecStart=/bin/bash %h/Code/omni_home/omnibase_infra/scripts/disk-gc.sh --execute

# 3. Conservative volume GC. Only unused anonymous volumes and unused ephemeral
#    boot Redpanda volumes are removable; linked lane/runtime Redpanda volumes
#    are never removed by this pass.
ExecStart=/bin/bash %h/Code/omni_home/omnibase_infra/scripts/docker-volume-gc.sh --execute

# 4. Watermark alert ratchet (non-zero exit on breach is expected; do not fail the unit).
ExecStart=-/bin/bash %h/Code/omni_home/omnibase_infra/scripts/disk-watermark-check.sh --mount /data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=onex-disk-gc

[Install]
WantedBy=default.target
