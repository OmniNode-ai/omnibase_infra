#
# Host-local configuration for onex-shadow-review.service (OMN-20422).
#
#   install -m 600 deploy/shadow-review/shadow-review.env.example ~/.config/onex/shadow-review.env
#
# This template carries NAMES only, every line commented. The copy on a host is
# never committed. Until SHADOW_REVIEW_WINDOW_START is set the tick reviews
# nothing, so a host can be installed and checked before the window opens.

# Registry root holding omnimarket, omniintelligence, the canonical clones and
# the clone refresh tool.
# OMNI_HOME=

# The omnimarket clone whose node_shadow_review_effect the tick runs; normally
# $OMNI_HOME/omnimarket written out in full.
# SHADOW_REVIEW_OMNIMARKET_DIR=

# A schema-1 PR watcher state file kept fresh on this host (at most
# SHADOW_REVIEW_MAX_STATE_AGE_S old when a tick starts).
# SHADOW_REVIEW_WATCHER_STATE=

# harness_delegate.py of the omni plugin on this host, for arm A2 (GLM 5.3).
# SHADOW_REVIEW_HARNESS_SCRIPT=

# T1: the stamp of the ledger STATUS row that starts the runner (UTC, Z form).
# SHADOW_REVIEW_WINDOW_START=

# Optional overrides of the unit defaults.
# SHADOW_REVIEW_STORE=
# SHADOW_REVIEW_MAX_STATE_AGE_S=
# SHADOW_REVIEW_MAX_REVIEWS=
