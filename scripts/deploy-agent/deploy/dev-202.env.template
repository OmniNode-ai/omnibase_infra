#
# NAMES ONLY. The env file the dev-202 deploy-agent instance sources
# (deploy-agent-dev-202.service: DEPLOY_AGENT_ENV_FILE=~/.omnibase/dev-202.env)
# must define every name below. No value is ever committed here: values come
# from the operator secret store on the host at bring-up, and a line with a
# value fails tests/unit/test_dev_202_executor_lane_omn19522.py (OMN-19522).
#
# WHY THESE NAMES. The deploy agent hands its environment to `docker compose`
# for the dev-202 triple (docker-compose.infra.yml, docker-compose.dev-lane.yml,
# docker-compose.dev-202.yml). Compose interpolates the whole model, so every
# `${NAME:?...}` in those three files fails the command when unset, even for a
# service the dev-202 overlay disables by profile (onex-api, the cloud-migration
# one-shots, Keycloak, Infisical). Names docker/runtime-policy.env already
# supplies are not repeated. The test derives the same set from the compose
# files and fails when a new required name is not listed here.
#
# A DISABLED SERVICE'S NAME STILL NEEDS A VALUE, but not a real one: the image
# pins (ONEX_API_IMAGE, ONEX_CLOUD_MIGRATE_IMAGE) and the Keycloak and Infisical
# names are read by no container on this lane.
#
# Do not copy the .201 dev lane's file wholesale. Its broker, model-server and
# lab-tenant values name .201 surfaces; dev-202 has its own Postgres, Redpanda
# and Valkey, and binds no local model server (docker-compose.dev-202.yml).

# --- control bus: the agent's one tie to .201 (KAFKA_SASL_ENV_PREFIX=DEV_) ---
DEV_KAFKA_SASL_USERNAME=
DEV_KAFKA_SASL_PASSWORD=
DEPLOY_AGENT_HMAC_SECRET=

# --- this lane's own data stores ---
POSTGRES_PASSWORD=
OMNINODE_RUNTIME_PASSWORD=
ROLE_OMNIDASH_PASSWORD=
ROLE_OMNINODE_PASSWORD=
TENANT_PROJECTION_WRITER_PASSWORD=
VALKEY_PASSWORD=
DEV_REDPANDA_ADVERTISE_HOST=

# --- runtime and tenant administration ---
ALPHA_INVITE_ADMIN_SECRET=
ONEX_SERVICE_CLIENT_SECRET=
ONEX_REGISTRATION_AUTO_ACK=
ONEX_LAB_TENANT_STATE_DIR=
TENANT_BOOTSTRAP_ADMIN_SECRET=
TENANT_CLIENTS_ADMIN_SECRET=
TENANT_OFFBOARD_ADMIN_SECRET=
TENANT_TOPICS_ADMIN_SECRET=
