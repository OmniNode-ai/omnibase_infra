#
# User-scope systemd unit for the DEV-202 deploy-agent instance (OMN-19522), the
# second dev-lane deploy slot on the .202 host (epic OMN-19500, plan
# knowledge-base-internal beta/plans/2026-09-24-second-deploy-slot-plan.md B3).
#
# NOT INSTALLED. This file is in the repo so the instance's shape is reviewed
# and tested before any host runs it. Installing it waits on decision 19 of the
# unified verification plan (no clone and no .git on .202 while the clean-
# machine producers run bare there); omninode_infra#1663 is the last of those
# producers' moves into a disposable container. The install, when it is ruled,
# is the documented control path of the .201 dev unit:
#   cp deploy-agent-dev-202.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now deploy-agent-dev-202.service
#
# WHAT DIFFERS FROM deploy-agent-dev.service, AND WHY
#
# * DEPLOY_AGENT_INSTANCE=dev-202 names the routing instance explicitly rather
#   than leaving it to the host-name match in config/deploy_lane_routing.yaml.
#   The instance picks the consumer group (onex-deploy-agent-dev-202, so this
#   process reads every record the .201 instance reads) and the dev lane's
#   composition (deploy_agent.executor.DEV_INSTANCE_LANE_CONFIGS: project
#   omnibase-infra-dev-202, the dev-202 overlay, health ports 61085/61086), and
#   switches off the .201-only phases (gateway deploy, k3s onex-lab overlay,
#   onex-api pin delivery, Infisical seed).
# * Its own health port, 61098, inside dev-202's 61000-61999 port block and
#   bound by no container of the lane.
# * Its own state dir (jobs-dev-202) and its own env file (dev-202.env). The
#   names that file must carry, and nothing else, are in
#   dev-202.env.template beside this unit; no value is ever committed.
#
# WHAT IS THE SAME, ON PURPOSE
#
# * The control bus. The dev control topic lives on the .201 dev broker's
#   external SASL listener, and that read is this lane's ONLY tie to .201. The
#   SCRAM principal is read from the env file under the DEV_ prefix, exactly as
#   on the .201 unit (see that unit's CONTROL-BUS TRANSPORT section).
# * The lane fence (dev only), the tracking ref (dev), the launcher transport
#   with no EnvironmentFile= (OMN-18073), the protected list covering every
#   name declared here, the fail-fast port preflight and the start limit. The
#   reasoning for each is in deploy-agent-dev.service and is not repeated.

[Unit]
# OMN-16939: bound the fail-fast refusal loop (see PORT PREFLIGHT in deploy-agent-dev.service).
StartLimitIntervalSec=300
StartLimitBurst=5
Description=ONEX Deploy Agent (dev-202 instance) — Kafka-driven rebuild orchestrator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/omninode/omnibase_infra/scripts/deploy-agent
Environment=DEPLOY_AGENT_ENV_FILE=/home/jonah/.omnibase/dev-202.env
Environment=DEPLOY_AGENT_PYTHON=/data/omninode/omnibase_infra/scripts/deploy-agent/.venv/bin/python
Environment="DEPLOY_AGENT_ENV_PROTECTED=DEPLOY_AGENT_ENV_FILE DEPLOY_AGENT_PYTHON DEPLOY_AGENT_ENV_PROTECTED DEPLOY_AGENT_INSTANCE DEPLOY_AGENT_DIR DEPLOY_AGENT_STATE_DIR DEPLOY_AGENT_PORT DEPLOY_AGENT_TRACKING_REF DEPLOY_AGENT_ALLOWED_LANES KAFKA_BOOTSTRAP_SERVERS KAFKA_ENVIRONMENT KAFKA_SECURITY_PROTOCOL KAFKA_SASL_MECHANISM KAFKA_SASL_ENV_PREFIX"
Environment=DEPLOY_AGENT_DIR=/data/omninode/omnibase_infra/scripts/deploy-agent
Environment=DEPLOY_AGENT_INSTANCE=dev-202
Environment=DEPLOY_AGENT_STATE_DIR=/data/omninode/deploy-agent/state/jobs-dev-202
Environment=DEPLOY_AGENT_PORT=61098
Environment=DEPLOY_AGENT_TRACKING_REF=dev
Environment=DEPLOY_AGENT_ALLOWED_LANES=dev
Environment=KAFKA_BOOTSTRAP_SERVERS=192.168.86.201:19092
Environment=KAFKA_ENVIRONMENT=dev
Environment=KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
Environment=KAFKA_SASL_MECHANISM=SCRAM-SHA-256
Environment=KAFKA_SASL_ENV_PREFIX=DEV_
ExecStartPre=/data/omninode/omnibase_infra/scripts/deploy-agent/deploy/preflight_port_free.sh 61098
ExecStart=/data/omninode/omnibase_infra/scripts/deploy-agent/deploy/deploy-agent-launch.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deploy-agent-dev-202

[Install]
WantedBy=default.target
