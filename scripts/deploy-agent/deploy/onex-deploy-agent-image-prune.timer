# OMN-19998
[Unit]
Description=Hourly deploy agent unreferenced runtime image cleanup

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Unit=onex-deploy-agent-image-prune.service

[Install]
WantedBy=timers.target
