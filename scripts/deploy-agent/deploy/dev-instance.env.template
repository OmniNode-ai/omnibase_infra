# NAMES ONLY. The env file a non-default deploy-agent instance sources
# (dev-202: deploy-agent-dev-202.service, ~/.omnibase/dev-202.env; dev-200 and
# the other macOS instances: the rendered LaunchAgent in launchd/,
# ~/.omnibase/<instance>.env) must define every name below. No value is ever
# committed here: values come from the operator secret store on the host at
# bring-up, and a line with a value fails
# tests/unit/test_dev_202_executor_lane_omn19522.py (OMN-19522). One template
# for every instance (OMN-19543): the instances' overlays differ only in names
# and ports, so the compose triple each renders requires the same names.
#
# WHY THESE NAMES. The deploy agent hands its environment to `docker compose`
# for the instance's triple (docker-compose.infra.yml, docker-compose.dev-lane.yml,
# its own docker-compose.<instance>.yml). Compose interpolates the whole model,
# so every `${NAME:?...}` in those three files fails the command when unset,
# even for a service the overlay disables by profile (onex-api, the
# cloud-migration one-shots, Keycloak, Infisical). Names docker/runtime-policy.env
# already supplies are not repeated. The test derives the same set from the
# compose files and fails when a new required name is not listed here.
#
# A DISABLED SERVICE'S NAME STILL NEEDS A VALUE, but not a real one: the image
# pins (ONEX_API_IMAGE, ONEX_CLOUD_MIGRATE_IMAGE) and the Keycloak and Infisical
# names are read by no container on these lanes.
#
# Do not copy the .201 dev lane's file wholesale. Its broker, model-server and
# lab-tenant values name .201 surfaces; each instance has its own Postgres,
# Redpanda and Valkey, and binds no local model server.
#
# OMNI_HOME: the workspace build stages the sibling repositories from it
# (finding (b) of the dev-202 bring-up, omni_home ledger TERMINAL
# 2026-09-25T09:22:26Z). The systemd unit of dev-202 reads it from this file;
# the LaunchAgent sets it in the plist, and the launcher keeps the plist's value.
OMNI_HOME=

# --- control bus: the agent's one tie to .201 (KAFKA_SASL_ENV_PREFIX=DEV_) ---
DEV_KAFKA_SASL_USERNAME=
DEV_KAFKA_SASL_PASSWORD=
DEPLOY_AGENT_HMAC_SECRET=

# --- this lane's own data stores ---
POSTGRES_PASSWORD=
OMNINODE_RUNTIME_PASSWORD=
ROLE_OMNIDASH_PASSWORD=
ROLE_OMNINODE_PASSWORD=
TENANT_PROJECTION_WRITER_PASSWORD=
VALKEY_PASSWORD=
DEV_REDPANDA_ADVERTISE_HOST=

# --- runtime and tenant administration ---
ALPHA_INVITE_ADMIN_SECRET=
ONEX_SERVICE_CLIENT_SECRET=
ONEX_REGISTRATION_AUTO_ACK=
ONEX_LAB_TENANT_STATE_DIR=
TENANT_BOOTSTRAP_ADMIN_SECRET=
TENANT_CLIENTS_ADMIN_SECRET=
TENANT_OFFBOARD_ADMIN_SECRET=
TENANT_TOPICS_ADMIN_SECRET=
LOCAL_LLM_SHARED_SECRET=

# --- model endpoints and provider keys ---
LLM_CODER_FAST_URL=
LLM_CODER_URL=
LLM_DEEPSEEK_R1_URL=
LLM_EMBEDDING_URL=
LLM_ENDPOINT_CIDR_ALLOWLIST=
LLM_GLM_API_KEY=
LLM_GLM_MODEL_NAME=
LLM_GLM_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- third-party integrations ---
GITHUB_TOKEN=
LINEAR_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- services disabled on dev-202, still interpolated by compose ---
ONEX_API_IMAGE=
ONEX_CLOUD_MIGRATE_IMAGE=
GATEWAY_ATTACH_KEYCLOAK_INTROSPECTION_URL=
GATEWAY_ATTACH_KEYCLOAK_JWKS_URL=
KEYCLOAK_ADMIN_CLIENT_SECRET=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_CONNECTION_URI=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_REDIS_URL=
