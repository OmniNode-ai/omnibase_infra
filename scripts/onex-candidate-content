# Governed entrypoint for an attested dirty-workspace candidate.  The ordinary
# `onex` wrapper deliberately retains its canonical-workspace behavior; this
# launcher is the only supported content-snapshot caller and cannot inherit a
# missing or downgraded provenance selector from its environment.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export ONEX_CANDIDATE_PROVENANCE_MODE=content
if [[ "${1:-}" != "delegate" ]]; then
  printf '%s\n' 'onex-candidate-content supports only the delegate command' >&2
  exit 2
fi
exec "$SCRIPT_DIR/onex" delegate --candidate-content-floor "${@:2}"
