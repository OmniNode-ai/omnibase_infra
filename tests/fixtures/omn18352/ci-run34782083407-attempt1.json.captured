ithub/workflows/deploy-agent-tests.yml@773de146c8c6a2cd6d62aef0f5023c48d4e8d080","sha":"773de146c8c6a2cd6d62aef0f5023c48d4e8d080","ref":"refs/pull/3503/merge"},{"path":"OmniNode-ai/omnibase_infra/.github/workflows/runner-route-reusable.yml@773de146c8c6a2cd6d62aef0f5023c48d4e8d080","sha":"773de146c8c6a2cd6d62aef0f5023c48d4e8d080","ref":"refs/pull/3503/merge"},{"path":"OmniNode-ai/omnibase_infra/.github/workflows/reusable-runtime-boot.yml@773de146c8c6a2cd6d62aef0f5023c48d4e8d080","sha":"773de146c8c6a2cd6d62aef0f5023c48d4e8d080","ref":"refs/pull/3503/merge"},{"path":"OmniNode-ai/omnimarket/.github/workflows/merge-hold-gate-reusable.yml@d3182b6fb59b421383c793fcfea86a46b06b7b43","sha":"d3182b6fb59b421383c793fcfea86a46b06b7b43"},{"path":"OmniNode-ai/omnibase_core/.github/workflows/zone-filter.yml@fc20d08690f03593eb8c55fd2c02c5f0f75f2b68","sha":"fc20d08690f03593eb8c55fd2c02c5f0f75f2b68"}],"run_started_at":"2026-09-13T20:52:05Z","triggering_actor":{"login":"jonahgabriel","id":1002253,"node_id":"MDQ6VXNlcjEwMDIyNTM=","avatar_url":"https://avatars.githubusercontent.com/u/1002253?v=4","gravatar_id":"","url":"https://api.github.com/users/jonahgabriel","html_url":"https://github.com/jonahgabriel","followers_url":"https://api.github.com/users/jonahgabriel/followers","following_url":"https://api.github.com/users/jonahgabriel/following{/other_user}","gists_url":"https://api.github.com/users/jonahgabriel/gists{/gist_id}","starred_url":"https://api.github.com/users/jonahgabriel/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonahgabriel/subscriptions","organizations_url":"https://api.github.com/users/jonahgabriel/orgs","repos_url":"https://api.github.com/users/jonahgabriel/repos","events_url":"https://api.github.com/users/jonahgabriel/events{/privacy}","received_events_url":"https://api.github.com/users/jonahgabriel/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/runs/34782083407/attempts/1/jobs","logs_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/runs/34782083407/attempts/1/logs","check_suite_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/check-suites/94196738738","artifacts_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/runs/34782083407/artifacts","cancel_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/runs/34782083407/cancel","rerun_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/runs/34782083407/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/OmniNode-ai/omnibase_infra/actions/workflows/250488273","head_commit":{"id":"fe5db3856fe17fd96297be60732f9eb9d8742ef1","tree_id":"472d981b7e2f6069ae2c7ea3d31748f4f4af3d92","message":"fix(OMN-18345): skip lane-dependent tests where the lane is absent, fail where it is unwell\n\nNightly Tests failed 8/8 nights on two @pytest.mark.slow integration tests\nthat assert against .201 dev-lane compose containers inside a job that\nprovisions none (run 34732000001: \"Available: []\"). 208 of 210 selected\ntests passed; those two can never pass there.\n\nOne guard, tests/integration/lane_presence.py, answers exactly one question\n-- is this lane here? -- and never \"is this lane well?\". Docker absent or\nnone of the named containers present skips; any one present returns and the\ncaller's own assertions run, so an unhealthy or partially-missing lane is\nstill RED. `docker ps -a` keeps an exited container counted as present.\n\ntest_no_containers_stuck_in_starting also moves onto the guard: it iterated\ncontainers that exist, so with no lane it passed VACUOUSLY. A skip states\nthat; the green did not.\n\nFalsification controls run, not asserted: neutering the presence comparison\nturns 3 of 9 tests RED (they fail rather than skip -- an unexpected skip is\nconverted to pytest.fail, because a skip exits 0 and would be green-by-\nskipping, the exact non-probative shape this fixes); a new unguarded\ncontainer-inspecting module turns the policy scan RED naming the file; the\nscan's own positive control refuses a zero detection.\n\nWired as a pre-commit hook in the same change. The policy scan excludes\ntests/integration/docker/ on evidence, not convenience: those modules\ndocker build the containers they inspect and both nightly jobs already pass\n--ignore for that directory.\n\nDev-lane runtime liveness stays observed by dev-lane-liveness.yml, so no\nobservation is removed.\n\nVerified: pre-commit run --all-files exit 0 (117 hooks); mypy --strict clean\non all four files; the two tests now skip with a reason naming the absent\ncontainers.","timestamp":"2026-09-13T20:48:57Z","author":{"name":"jonahgabriel","email":"jonah@omninode.ai"},"committer":{"name":"jonahgabriel","email":"jonah@omninode.ai"}},"repository":{"id":1054876596,"node_id":"R_kgDOPuAjtA","name":"omnibase_infra","full_name":"OmniNode-ai/omnibase_infra","private":false,"owner":{"login":"OmniNode-ai","id":209038818,"node_id":"O_kgDODHWt4g","avatar_url":"https://avatars.githubusercontent.com/u/209038818?v=4","gravatar_id":"","url":"https://api.github.com/users/OmniNode-ai","html_url":"https://github.com/OmniNode-ai","followers_url":"https://api.github.com/users/OmniNode-ai/followers","following_url":"https://api.github.com/users/OmniNode-ai/following{/other_user}","gists_url":"https://api.github.com/users/OmniNode-ai/gists{/gist_id}","starred_url":"https://api.github.com/users/OmniNode-ai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/OmniNode-ai/subscriptions","organizations_url":"https://api.github.com/users/OmniNode-ai/orgs","repos_url":"https://api.github.com/users/OmniNode-ai/repos","events_url":"https://api.github.com/users/OmniNode-ai/events{/privacy}","received_events_url":"https://api.github.com/users/OmniNode-ai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://g